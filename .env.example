# Signs session cookies for the web platform. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBAPP_SECRET_KEY=

# Supabase: hosts user accounts, student metadata (name, status, bio, learner
# profile), and the progress log. Project Settings > API in your Supabase
# dashboard. Run webapp/supabase_schema.sql once in the SQL Editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Qdrant: hosts the actual embedded notes/history per student.
QDRANT_URL=
QDRANT_API_KEY=

# Required everywhere (unlike persona_mcp): ask_tutor generates the tutoring
# reply server-side, and ingestion uses this to build the learner profile.
ANTHROPIC_API_KEY=sk-ant-...

# Used only by the local single-tenant CLI/server (student_adaptive_mcp/ingest.py,
# server.py), not by the web platform (webapp/). Still needs QDRANT_URL/
# QDRANT_API_KEY above (vector memory is Qdrant everywhere now), but is
# otherwise independent of Supabase/the web app's accounts.
STUDENT_NAME=
# Optional: override where students/ lives, defaults to the repo root.
# STUDENT_MCP_HOME=D:\student_adaptive_mcp\students
